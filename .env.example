# ------------------------------------------------------------------
# Mercado Pago  (portal de pago)
# ------------------------------------------------------------------
# Access Token de tu cuenta de Mercado Pago (Producción o Prueba).
# Dónde: https://www.mercadopago.cl/developers/panel  ->  Tus integraciones
#        ->  (tu aplicación)  ->  Credenciales  ->  Access Token
# Agrégalo como variable de entorno en Vercel con este mismo nombre
# (y en .env.local para probar en tu PC).
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------
# Meta Pixel (Facebook Pixel)
# ------------------------------------------------------------------
# ID numérico del Pixel. Debe empezar con NEXT_PUBLIC_ para que el
# navegador pueda leerlo. Si se deja vacío, el sitio funciona igual
# pero sin tracking.
#   1. Meta Events Manager: https://business.facebook.com/events_manager2
#   2. Selecciona (o crea) tu Conjunto de datos / Pixel.
#   3. Configuración -> copia el "ID del conjunto de datos" / "Pixel ID".
NEXT_PUBLIC_META_PIXEL_ID=

# ------------------------------------------------------------------
# URL pública de la tienda (opcional, recomendado)
# ------------------------------------------------------------------
# Se usa para las URLs de retorno de Mercado Pago (/gracias, etc.).
# Si se deja vacío se usa el dominio desde el que llega la compra.
# Ejemplo: SITE_URL=https://www.tutienda.cl
SITE_URL=
